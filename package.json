{
  "name": "persianmeow",
  "version": "1.0.0",
  "private": true,
  "description": "PersianMeow: learn Persian (Farsi) from A1 to B2 with Pishi the Persian cat. Finglish and recorded audio for every word, alphabet, grammar, dialogues, readings and spaced review.",
  "license": "MIT",
  "author": "Shabnaz Ghaffari",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run check:content && npm run check:italian && node scripts/check-voices.ts && vue-tsc --build && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --build --force",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check:content": "node scripts/check-content.ts",
    "cap:sync": "npm run build && cap sync",
    "icons": "node scripts/make-art.ts && node scripts/render-icons.mjs && capacitor-assets generate --iconBackgroundColor #0a7b7a --iconBackgroundColorDark #0a7b7a --splashBackgroundColor #eef3f6 --splashBackgroundColorDark #0c1524",
    "audio": "node scripts/gen-audio.ts",
    "check:italian": "node scripts/check-italian.ts",
    "check:bego": "node scripts/check-bego.ts",
    "build:bego": "npm run check:bego && vue-tsc --build && vite build --mode begociao",
    "dev:bego": "vite --mode begociao",
    "test:bego": "vitest run --mode begociao",
    "preview:bego": "vite preview --mode begociao",
    "check:spoken": "node scripts/check-spoken.ts",
    "check:vowels": "node scripts/check-vowels.ts",
    "check:voices": "node scripts/check-voices.ts && node scripts/check-voices-bego.mjs",
    "check:tracks": "node scripts/check-tracks.ts",
    "check:dictionary": "node scripts/check-dictionary.ts",
    "pull:reviews": "node scripts/pull-reviews.ts"
  },
  "dependencies": {
    "@capacitor-community/text-to-speech": "8.0.2",
    "@capacitor/android": "8.6.0",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.6.0",
    "@capacitor/ios": "8.6.0",
    "@supabase/supabase-js": "2.119.0",
    "vue": "^3.5.46",
    "vue-router": "^5.5.2"
  },
  "devDependencies": {
    "@capacitor/assets": "4.0.0",
    "@capacitor/cli": "8.6.0",
    "@playwright/test": "^1.65.1",
    "@types/node": "^24.19.4",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.15.0",
    "eslint-plugin-vue": "^10.12.1",
    "jiti": "^2.7.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.4.0",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "^5.1.2",
    "vue-tsc": "^3.3.14"
  }
}
